<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!-- ============================================================
       应用配置
       ============================================================
       1. 心跳配置（HeartbeatConfig.LoadFromConfig 读取）
       2. S7NetPlus 异步读写超时（S7TimeoutConfig.LoadFromConfig 读取）
       ============================================================ -->
  <appSettings>

    <!-- ============================================================
         心跳配置
         ============================================================
         【非对称阈值设计】
           判离线：RequiredConsecutive（大）→ 防误判
           判在线：RequiredConsecutiveOnline（小）→ 快速恢复

         【两个关键公式】
           判离线时间 = RequiredConsecutive × ReadIntervalMs
           判在线时间 = RequiredConsecutiveOnline × ReadIntervalMs

         【必须满足的约束】
           TimeoutMs > RequiredConsecutive × ReadIntervalMs
           RequiredConsecutiveOnline ≤ RequiredConsecutive
         ============================================================ -->

    <!-- 【判离线】连续失败阈值
         - 太小（如 5）：网络抖动 2.5 秒就误判离线
         - 太大（如 30）：真宕机响应太慢
         推荐 10 → 判离线时间 = 10 × 500ms = 5 秒 -->
    <add key="Heartbeat.RequiredConsecutive" value="10" />

    <!-- 【判在线】连续成功阈值
         - 这个值要小，网络恢复后才能快速切回 Online
         - 推荐 3 → 判在线时间 = 3 × 500ms = 1.5 秒 -->
    <add key="Heartbeat.RequiredConsecutiveOnline" value="3" />

    <!-- 【心跳读取间隔】（毫秒）
         心跳循环每多少毫秒执行一次读操作。500ms 是行业默认值，不建议改。 -->
    <add key="Heartbeat.ReadIntervalMs" value="500" />

    <!-- 【心跳超时】（毫秒）
         距上次成功读心跳超过该时间，直接判离线（兜底机制）。
         约束：必须 > RequiredConsecutive × ReadIntervalMs（这里是 5 秒）
         推荐 20 秒 → 是判离线时间的 4 倍，足够兜底 -->
    <add key="Heartbeat.TimeoutMs" value="20000" />

    <!-- 【离线关闭业务连接等待时间】（秒）
         心跳判离线后，等多少秒才主动关闭业务连接释放资源。
         推荐 120 秒 → 给网络抖动留 2 分钟容错窗口 -->
    <add key="Heartbeat.OfflineCloseBusinessSeconds" value="120" />

    <!-- ============================================================
         S7NetPlus 异步读写超时（毫秒）
         ============================================================
         S7TimeoutConfig.LoadFromConfig 读取
         现场改这些值后重启程序即可生效，不需要重新编译

         各配置项含义：
           S7.TimeoutMs.ReadInt32        : 单值 ReadInt32Async 超时
           S7.TimeoutMs.ReadString       : 单值 ReadStringAsync 超时
           S7.TimeoutMs.ReadStringsBatch : 批量 ReadStringsBatchAsync 超时
           S7.TimeoutMs.WriteInt32       : 单值 WriteInt32Async 超时
           S7.TimeoutMs.WriteString      : 单值 WriteStringAsync 超时
           S7.TimeoutMs.Array            : DInt/Real 数组读写超时
         ============================================================ -->

    <!-- 单值 ReadInt32 超时，默认 2000ms -->
    <add key="S7.TimeoutMs.ReadInt32" value="2000" />

    <!-- 单值 ReadString 超时，默认 2000ms -->
    <add key="S7.TimeoutMs.ReadString" value="2000" />

    <!-- 批量 ReadStringsBatch 超时，默认 6000ms（批量 20 个 String 正常约 4000ms，留 1.5 倍余量） -->
    <add key="S7.TimeoutMs.ReadStringsBatch" value="8000" />

    <!-- 单值 WriteInt32 超时，默认 2000ms -->
    <add key="S7.TimeoutMs.WriteInt32" value="3500" />

    <!-- 单值 WriteString 超时，默认 2000ms -->
    <add key="S7.TimeoutMs.WriteString" value="3000" />

    <!-- DInt/Real 数组读写超时，默认 3000ms -->
    <add key="S7.TimeoutMs.Array" value="3000" />

  </appSettings>
</configuration>